# Configure real values in Vercel, never in Git.
MONGO_URL=
DB_NAME=servicoja
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
BLOB_READ_WRITE_TOKEN=
STORAGE_PROVIDER=vercel
SEED_DEMO=false
# Only required for a separate frontend origin; same-origin needs no CORS allowance.
CORS_ORIGINS=

# Server-only payments. Production takes precedence; invalid configuration fails closed.
ASAAS_PRODUCTION_ENABLED=false
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# Existing preview-only sandbox (isolated balances and credentials).
ASAAS_SANDBOX_ENABLED=false
ASAAS_SANDBOX_API_KEY=
ASAAS_SANDBOX_WEBHOOK_TOKEN=

# Optional scheduler authentication for GET /api/internal/jobs.
# Use a random secret of at least 32 characters; never expose it in the frontend.
# Normal authenticated activity also resumes persisted work.
CRON_SECRET=

# Exact frontend origins allowed for Clerk sessions and cookie-authenticated writes.
# Vercel deployment/branch/production URLs are included automatically. Add custom domains here.
CLERK_AUTHORIZED_PARTIES=
